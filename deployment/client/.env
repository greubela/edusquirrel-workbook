# EduSquirrel client loader defaults.
# Runtime settings are read by Scala.js after the app shell paints.
# Bundle paths are legacy bootstrap fallbacks if the default bundle is absent.
# For a preferred custom bundle, set EDUSQUIRREL_APP_PATHS before app-loader.js.
EDUSQUIRREL_APP_SCRIPT_PRIMARY=../../artifacts/newest/client.js
EDUSQUIRREL_APP_SCRIPT_SECONDARY=../../artifacts/newest/client-fastOpt.js
EDUSQUIRREL_APP_SCRIPT_TERTIARY=../../artifacts/stable/client.js
EDUSQUIRREL_BACKEND_MODULE_WORKERS=1
# Deprecated: optional runtimes never gate first rendering.
INIT_WORKBOOK_ONLY_AFTER_ALL_DEPENDENCIES_LOADED=false
WRITE_FULL_LOGFILES=false
