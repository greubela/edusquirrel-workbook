# Database used by deploy-database.sh: copy to database.env and fill in.
# server.env must contain the same SQL_* values; deploy-server.sh refuses a mismatch.
SQL_HOST=herrgreubel.lima-db.de
SQL_PORT=3306
SQL_DATABASE=db_332371_13
SQL_USER=USER332371_ang08
SQL_PW=

# Databases that "setup" and "reset" never modify (comma-separated), e.g. ones shared with other projects.
DATABASE_PROTECTED=db_332371_12
# Explicit opt-in: must equal SQL_DATABASE before "setup" or "reset" may run.
DATABASE_ALLOW_RESET=db_332371_13
# Builds the reference schema for "check"; match the server's MySQL version for an exact comparison.
DATABASE_MYSQL_IMAGE=mysql:8.4
