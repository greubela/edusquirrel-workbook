# Settings for deploy-database.sh: copy to database.env and fill in.
# The connection (SQL_HOST, SQL_PORT, SQL_DATABASE, SQL_USER, SQL_PW) is read from server.env,
# so the backend and the schema check always use the same database.

# Databases that "setup" and "reset" never modify (comma-separated), e.g. ones shared with other projects.
DATABASE_PROTECTED=db_332371_12
# Explicit opt-in: must equal SQL_DATABASE from server.env before "setup" or "reset" may run.
DATABASE_ALLOW_RESET=db_332371_13
# Builds the reference schema for "check"; match the server's MySQL version for an exact comparison.
DATABASE_MYSQL_IMAGE=mysql:8.4
