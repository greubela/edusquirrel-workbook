# Uploaded as the backend's Docker Compose .env: copy to server.env and fill in.
# SERVER_VERSION is added by deploy-server.sh from `git describe`.
SERVER_HOSTNAME=ypcgzj23.trafficplex.cloud
# Leave SERVER_ALLOWED_ORIGINS unset here: Caddy sets CORS headers (local use: docs/deployment.md#local-backend).
# Signs login tokens; use a long random value and keep it stable between deployments.
SERVER_SECRET=

# The backend's database; deploy-database.sh checks and sets up the same one.
SQL_HOST=herrgreubel.lima-db.de
SQL_PORT=3306
SQL_DATABASE=db_332371_13
SQL_USER=USER332371_ang08
SQL_PW=
DB_FORMAT=mysql

# Server-side defaults for LLM requests without their own configuration.
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
# OPENAI_PROGRAMMING_HINT_MODEL=gpt-5
OPENAI_API_KEY=
OPENAI_MAX_TOKENS=

# Outgoing mail (login codes, workbook submissions); real mail is sent. Set both MAIL_EMAIL and MAIL_PW or neither.
MAIL_EMAIL=no-reply@evadid.it
MAIL_PW=
MAIL_SMTP_HOST=mail.lima-city.de
MAIL_SMTP_PORT=587
# Receives the full copy of every workbook submission.
SUBMISSION_ARCHIVE_MAIL=andre.greubel@hu-berlin.de

# Optional allow-listed teaching databases for the SQL editor (comma-separated).
SQL_EDITOR_DATABASES=
SQL_EDITOR_USER=
SQL_EDITOR_PW=
