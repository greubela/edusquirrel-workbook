# Settings of the machine that runs the deployment: copy to local.env and fill in.
# The filled-in copy is ignored by Git. Single-quote values that contain '$', quotes or spaces.

# --- Backend server (deployment/server/deploy-server.sh) ---
SERVER_SSH_HOST=ypcgzj23.trafficplex.cloud
SERVER_SSH_PORT=22
SERVER_SSH_USER=andre
SERVER_SSH_KEY=~/.ssh/edusquirrel_ecdsa
# Unlocks the key once through a private ssh-agent. Leave empty to type it or use your own agent.
SERVER_SSH_KEY_PASSPHRASE=
# Optional dedicated known_hosts file; an unknown host key is accepted on first use.
SERVER_SSH_KNOWN_HOSTS=
# Absolute path holding docker-compose.yml, .env, update-docker.sh and artifacts/newest/server.jar.
SERVER_REMOTE_DIR=/home/andre/javaserver
# Checked after the update; must report the deployed SERVER_VERSION. Leave empty to skip.
SERVER_HEALTH_URL=https://ypcgzj23.trafficplex.cloud/health

# --- Database tools (deployment/database/deploy-database.sh) ---
# "server": MySQL clients run in Docker on the backend server via SSH; "local": local Docker.
DATABASE_TOOLS_HOST=server

# --- Webspace (deployment/client/deploy-client.sh) ---
CLIENT_FTP_HOST=herrgreubel.lima-ftp.de
CLIENT_FTP_USER=herrgreubel
CLIENT_FTP_PASSWORD=
# Require FTPS (explicit TLS). Set to false only if the host offers plain FTP alone.
CLIENT_FTP_TLS=true
# Relative to the FTP login directory; served as https://evadid.it/edusquirrel/
# (so homepage/index.html is https://evadid.it/edusquirrel/homepage/index.html).
CLIENT_FTP_ROOT=EvaHomepage/edusquirrel
