# EduSquirrel client runtime configuration: copy to client.env and adjust.
# deploy-client.sh publishes it as deployment/client/.env, which ClientRuntimeConfig fetches.
# It is PUBLIC on the website: never put credentials here (deploy-client.sh refuses
# keys that look like passwords, secrets, tokens or keys). Missing values use the defaults.
EDUSQUIRREL_APP_SCRIPT_PRIMARY=../../artifacts/newest/client.js
EDUSQUIRREL_APP_SCRIPT_SECONDARY=../../artifacts/newest/client-fastOpt.js
EDUSQUIRREL_APP_SCRIPT_TERTIARY=../../artifacts/stable/client.js
EDUSQUIRREL_BACKEND_MODULE_WORKERS=1
INIT_WORKBOOK_ONLY_AFTER_ALL_DEPENDENCIES_LOADED=true
WRITE_FULL_LOGFILES=false
